library/**/*
!library/**/.gitkeep

# 依赖
node_modules/
apps/server/node_modules/
apps/web/node_modules/

# 构建产物
apps/web/dist/

# 本机 curl-impersonate（Windows 安装脚本下载，勿提交）
tools/curl-impersonate/

